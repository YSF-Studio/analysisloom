{
  "name": "analysisloom",
  "private": true,
  "workspaces": ["packages/analysisloom"],
  "scripts": {
    "dev:analysisloom": "cd packages/analysisloom && npm run tauri dev",
    "build:analysisloom": "cd packages/analysisloom && npm run tauri build",
    "test:all": "cd packages/analysisloom/src-tauri && cargo test",
    "test:integration": "cd packages/analysisloom/src-tauri && cargo test --test full_integration -- --nocapture",
    "test:fixtures": "cd packages/analysisloom/src-tauri && cargo run --example export_fixtures -- ../../test-fixtures",
    "test:gui": "node scripts/smoke-gui.mjs",
    "test:full": "bash scripts/run-full-test.sh",
    "lint": "cd packages/analysisloom/src-tauri && cargo clippy --all-targets -- -D warnings",
    "fmt:check": "cd packages/analysisloom/src-tauri && cargo fmt --all -- --check",
    "audit:rust": "cd packages/analysisloom/src-tauri && cargo audit",
    "audit:npm": "npm audit --audit-level=high"
  }
}
